# Shared local defaults. Copy app-specific examples into each app:
#   cp apps/web/.env.example apps/web/.env.local
#   cp apps/builder/.env.example apps/builder/.env.local
#   cp apps/api/.env.example apps/api/.env

NODE_ENV=development

# apps/api
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cinematic
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# apps/web and apps/builder
NEXT_PUBLIC_API_URL=http://localhost:4000
