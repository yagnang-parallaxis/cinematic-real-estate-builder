# Shared local defaults. Copy app-specific examples into each app:
#   cp apps/web/.env.example apps/web/.env.local
#   cp apps/builder/.env.example apps/builder/.env.local
#   cp apps/api/.env.example apps/api/.env

NODE_ENV=development

# apps/api
API_PORT=4000
API_HOST=0.0.0.0

# Docker Compose (pnpm docker:up) — non-default host ports to avoid clashes
#   Postgres → localhost:15432
#   Redis    → localhost:16379
DATABASE_URL=postgresql://cinematic:cinematic@localhost:15432/cinematic
REDIS_URL=redis://localhost:16379

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# apps/web and apps/builder
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# packages/clone-mcp — MCP server for AI agents (see packages/clone-mcp/README.md).
# Editors pass these in the MCP entry's `env` block, not through a .env file.
CLONE_API_URL=http://localhost:4000
CLONE_WEB_URL=http://localhost:3000
CLONE_BUILDER_URL=http://localhost:3001
# Where export_clone writes zips; defaults to <tmpdir>/cinematic-clone-exports
# CLONE_EXPORT_DIR=/absolute/path/to/exports
